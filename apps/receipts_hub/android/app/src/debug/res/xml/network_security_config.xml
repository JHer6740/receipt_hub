<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. This file does not exist in a release build, which uses
  src/main's config and refuses cleartext outright.

  Cleartext is permitted broadly here rather than for a list of hosts, because
  a local backend is reached at a different address depending on the device:
  the emulator uses 10.0.2.2, a physical phone needs the development machine's
  LAN address (192.168.x.x, 10.x.x.x, …), and that address changes. A
  network-security-config can only name exact domains, not ranges, so an
  allow-list either has to be edited per machine or silently blocks the
  developer host screen — which is what it did.

  This is safe because it applies only to debug builds, and it is why
  AppConfig.allowHostOverride and kDebugMode gate that screen too: a release
  APK has neither the permission nor the UI.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- Lets a debug build trust a locally installed CA, for
                 inspecting traffic with a proxy during development. -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
